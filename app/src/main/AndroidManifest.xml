<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UniNest"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Add Building (opened from Buildings screen) -->
        <activity
            android:name=".ui.auth.AddBuildingActivity"
            android:exported="false" />

        <!-- BUILDINGS = TEMP LAUNCHER SCREEN -->
        <activity
            android:name=".ui.auth.LettingAgentBuildingsActivity"
            android:exported="true">

            <!-- This makes it the first screen when app starts -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tenant sign-up kept, but NOT launcher now -->
        <activity
            android:name=".ui.auth.TenantSignUpActivity"
            android:exported="false" />

        <!-- MainActivity still exists but not launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>

</manifest>
