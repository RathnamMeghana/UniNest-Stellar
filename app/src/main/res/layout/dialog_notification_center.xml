<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_notification_center_panel"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_soft_badge"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="Alerts"
                    android:textColor="@color/app_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Your latest apartment updates"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_notification_center_header"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_soft_badge"
                android:padding="11dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/app_accent_purple" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alerts"
                    android:textColor="@color/app_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCenterAlertCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="0 active alerts"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCenterCountChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_soft_badge"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:importantForAccessibility="no"
                android:text="0"
                android:textColor="@color/app_text_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tap any alert to jump straight to the related screen. Each card shows the type, timing, and what changed."
            android:textColor="@color/app_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filterAlertsAll"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_tenant_calendar_metric_soft"
                android:fontFamily="@font/opensans_bold"
                android:gravity="center"
                android:minWidth="64dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="All"
                android:textColor="@color/calendar_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterAlertsMessages"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tenant_calendar_metric_soft"
                android:fontFamily="@font/opensans_bold"
                android:gravity="center"
                android:minWidth="84dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Messages"
                android:textColor="@color/calendar_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterAlertsBills"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tenant_calendar_metric_soft"
                android:fontFamily="@font/opensans_bold"
                android:gravity="center"
                android:minWidth="68dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Bills"
                android:textColor="@color/calendar_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterAlertsChores"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tenant_calendar_metric_soft"
                android:fontFamily="@font/opensans_bold"
                android:gravity="center"
                android:minWidth="72dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Chores"
                android:textColor="@color/calendar_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterAlertsMaintenance"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tenant_calendar_metric_soft"
                android:fontFamily="@font/opensans_bold"
                android:gravity="center"
                android:minWidth="100dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Maintenance"
                android:textColor="@color/calendar_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterAlertsCalendar"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tenant_calendar_metric_soft"
                android:fontFamily="@font/opensans_bold"
                android:gravity="center"
                android:minWidth="74dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Events"
                android:textColor="@color/calendar_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:layout_weight="1"
            android:text="Showing"
            android:textColor="@color/app_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCenterClearAll"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="@android:color/transparent"
            android:contentDescription="Clear all alerts"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Clear all"
            android:textAllCaps="false"
            android:textColor="@color/app_accent_purple"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            app:rippleColor="@color/app_outline"
            app:strokeColor="@color/app_accent_purple"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutCenterEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_tenant_calendar_empty_state"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="124dp"
            android:layout_height="104dp"
            android:importantForAccessibility="no">

            <View
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_home_orb_primary" />

            <View
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="bottom|start"
                android:background="@drawable/bg_home_orb_secondary" />

            <FrameLayout
                android:id="@+id/layoutCenterEmptyIconShell"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_tenant_calendar_metric_soft"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/imgCenterEmptyIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/app_accent_purple" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvCenterEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/opensans_bold"
            android:text="All caught up"
            android:textColor="@color/calendar_text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvCenterEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/opensans_regular"
            android:gravity="center"
            android:text="Fresh apartment updates will land here as soon as something needs your attention."
            android:textColor="@color/calendar_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotificationCenter"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:nestedScrollingEnabled="true" />
</LinearLayout>
