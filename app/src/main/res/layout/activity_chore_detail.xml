<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tenant_calendar_screen">

    <LinearLayout
        android:id="@+id/fixedHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tenant_calendar_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_tenant_calendar_metric_soft"
                android:clickable="true"
                android:contentDescription="Go back"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_back_arrow"
                    app:tint="@color/calendar_primary_dark" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/opensans_bold"
                    android:letterSpacing="0.08"
                    android:text="Planner"
                    android:textAllCaps="true"
                    android:textColor="@color/calendar_primary_dark"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/opensans_bold"
                    android:text="Chore Details"
                    android:textColor="@color/calendar_text_primary"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fixedHeaderContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tenant_calendar_section_chore"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/opensans_bold"
                    android:letterSpacing="0.06"
                    android:text="Task Overview"
                    android:textAllCaps="true"
                    android:textColor="@color/calendar_chore_text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvChoreTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/opensans_bold"
                    android:textColor="@color/calendar_text_primary"
                    android:textSize="24sp"
                    tools:text="Clean Kitchen" />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/opensans_regular"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/calendar_text_secondary"
                    android:textSize="14sp"
                    tools:text="Detailed description of the task goes here." />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:columnCount="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_tenant_calendar_surface_alt"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/opensans_bold"
                            android:text="Est. Time"
                            android:textAllCaps="true"
                            android:textColor="@color/calendar_text_secondary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvEstTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/opensans_bold"
                            android:textColor="@color/calendar_text_primary"
                            android:textSize="15sp"
                            tools:text="30 Mins" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_tenant_calendar_surface_alt"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/opensans_bold"
                            android:text="Location"
                            android:textAllCaps="true"
                            android:textColor="@color/calendar_text_secondary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvRoomInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/opensans_bold"
                            android:textColor="@color/calendar_text_primary"
                            android:textSize="15sp"
                            tools:text="Kitchen" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_tenant_calendar_surface_alt"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/opensans_bold"
                            android:text="Assigned To"
                            android:textAllCaps="true"
                            android:textColor="@color/calendar_text_secondary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvAssigneeInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/opensans_bold"
                            android:textColor="@color/calendar_text_primary"
                            android:textSize="15sp"
                            tools:text="John Doe" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_tenant_calendar_surface_alt"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/opensans_bold"
                            android:text="Due Date"
                            android:textAllCaps="true"
                            android:textColor="@color/calendar_text_secondary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvDueDateInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/opensans_bold"
                            android:textColor="@color/calendar_chore_text"
                            android:textSize="15sp"
                            tools:text="Jan 24, 2026" />
                    </LinearLayout>
                </GridLayout>

                <TextView
                    android:id="@+id/tvCreatedByInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/opensans_regular"
                    android:gravity="end"
                    android:textColor="@color/calendar_text_secondary"
                    android:textSize="12sp"
                    tools:text="Created by: Me" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tenant_calendar_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/opensans_bold"
                    android:letterSpacing="0.06"
                    android:text="Update Progress"
                    android:textAllCaps="true"
                    android:textColor="@color/calendar_primary_dark"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/opensans_regular"
                    android:text="Change the status, log the actual time, or swap this task with a roommate."
                    android:textColor="@color/calendar_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/opensans_bold"
                    android:labelFor="@id/spinnerStatus"
                    android:text="Current Status"
                    android:textColor="@color/calendar_text_primary"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tenant_calendar_spinner"
                    android:gravity="center_vertical"
                    android:paddingEnd="40dp"
                    android:popupBackground="@drawable/bg_tenant_calendar_dialog"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/opensans_bold"
                    android:labelFor="@id/etActualTime"
                    android:text="Actual Time Taken (Mins)"
                    android:textColor="@color/calendar_text_primary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etActualTime"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tenant_calendar_input"
                    android:fontFamily="@font/opensans_regular"
                    android:hint="Enter minutes"
                    android:inputType="number"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/calendar_text_primary"
                    android:textColorHint="@color/calendar_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/opensans_bold"
                    android:labelFor="@id/spinnerSwapUser"
                    android:text="Swap with Roommate"
                    android:textColor="@color/calendar_text_primary"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerSwapUser"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tenant_calendar_spinner"
                    android:gravity="center_vertical"
                    android:paddingEnd="40dp"
                    android:popupBackground="@drawable/bg_tenant_calendar_dialog"
                    android:spinnerMode="dropdown" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpdateChore"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_tenant_calendar_action_primary"
                    android:fontFamily="@font/opensans_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Save updates"
                    android:textAllCaps="false"
                    android:textColor="@color/calendar_text_inverse"
                    android:textSize="15sp"
                    app:backgroundTint="@null"
                    app:cornerRadius="16dp"
                    app:elevation="0dp"
                    app:strokeWidth="0dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
