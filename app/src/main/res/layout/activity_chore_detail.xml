<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 1. Header Blob  -->
    <View
        android:id="@+id/headerBgBlob"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@drawable/bg_header_green_circle"
        android:translationX="-50dp"
        android:translationY="-50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Back Button -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="54dp"
        android:layout_height="63dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:src="@drawable/ic_back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#000000" />

    <!-- 3. Screen Title -->
    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="Chore Details"
        android:textColor="#000000"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 4. Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Specific Chore Title -->
            <TextView
                android:id="@+id/tvChoreTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#333333"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                tools:text="Clean Kitchen" />

            <!-- TASK OVERVIEW CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TASK OVERVIEW"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"/>

                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#333"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp"
                        tools:text="Detailed description of the task goes here." />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:columnCount="2">

                        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginBottom="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EST. TIME" android:textSize="10sp" android:textColor="#9E9E9E" android:textStyle="bold" android:textAllCaps="true"/>
                            <TextView android:id="@+id/tvEstTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="#333" android:textSize="15sp" tools:text="30 Mins"/>
                        </LinearLayout>

                        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginBottom="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOCATION" android:textSize="10sp" android:textColor="#9E9E9E" android:textStyle="bold" android:textAllCaps="true"/>
                            <TextView android:id="@+id/tvRoomInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="#333" android:textSize="15sp" tools:text="Kitchen"/>
                        </LinearLayout>

                        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ASSIGNED TO" android:textSize="10sp" android:textColor="#9E9E9E" android:textStyle="bold" android:textAllCaps="true"/>
                            <TextView android:id="@+id/tvAssigneeInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="#333" android:textSize="15sp" tools:text="John Doe"/>
                        </LinearLayout>

                        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DUE DATE" android:textSize="10sp" android:textColor="#9E9E9E" android:textStyle="bold" android:textAllCaps="true"/>
                            <TextView android:id="@+id/tvDueDateInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="#4CAF50" android:textSize="15sp" tools:text="Jan 24, 2026"/>
                        </LinearLayout>
                    </GridLayout>

                    <TextView
                        android:id="@+id/tvCreatedByInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="end"
                        android:textColor="#BDBDBD"
                        android:textSize="11sp"
                        tools:text="Created by: Me" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- UPDATE PROGRESS CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UPDATE PROGRESS"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Current Status"
                        android:textColor="#333"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerStatus"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_spinner_field" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Actual Time Taken (Mins)"
                        android:textColor="#333"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etActualTime"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field"
                        android:inputType="number"
                        android:padding="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Swap with Roommate"
                        android:textColor="#333"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerSwapUser"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_spinner_field" />

                    <!-- Save Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpdateChore"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="24dp"
                        android:backgroundTint="#00BCD4"
                        android:text="Save Updates"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:cornerRadius="30dp"
                        app:elevation="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>