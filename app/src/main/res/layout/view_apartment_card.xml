<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_tenant_calendar_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/opensans_bold"
            android:letterSpacing="0.06"
            android:text="Apartment"
            android:textAllCaps="true"
            android:textColor="@color/calendar_primary_dark"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvApartmentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/opensans_bold"
            android:text="Apartment 1"
            android:textColor="@color/calendar_text_primary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvTenantInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_tenant_calendar_today_chip"
            android:fontFamily="@font/opensans_bold"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="5/5 Tenants"
            android:textColor="@color/calendar_today_chip_text"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnNotifyApartment"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_tenant_calendar_action_primary"
        android:contentDescription="Notify Tenants"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_notifications"
        android:tint="@color/calendar_text_inverse" />

    <ImageButton
        android:id="@+id/btnDeleteApartment"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_agent_delete_outline"
        android:contentDescription="Delete Apartment"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/delete"
        android:tint="@color/calendar_status_overdue_text" />

</LinearLayout>
