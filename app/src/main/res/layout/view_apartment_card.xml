<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_building_card"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#D4BAF1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvApartmentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Apartment 1" />

            <TextView
                android:id="@+id/tvTenantInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textColor="#6A6A6A"
                android:textSize="14sp"
                tools:text="5/5 Tenants" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnNotifyApartment"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_delete_circle_purple"
            android:contentDescription="Notify Tenants"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notifications"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnDeleteApartment"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_delete_circle_purple"
            android:contentDescription="Delete Apartment"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/delete"
            android:tint="@android:color/white" />
    </LinearLayout>

</FrameLayout>
