<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tenant_calendar_dialog"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/tvNameDialogEyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/opensans_bold"
        android:letterSpacing="0.08"
        android:text="Update name"
        android:textAllCaps="true"
        android:textColor="@color/calendar_primary_dark"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvNameDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/opensans_bold"
        android:text="Rename item"
        android:textColor="@color/calendar_text_primary"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/tvNameDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/opensans_regular"
        android:text="Choose the updated name you want to show across the app."
        android:textColor="@color/calendar_text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_tenant_calendar_surface_alt"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_tenant_calendar_metric_primary"
            android:padding="11dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_edit"
                app:tint="@color/calendar_text_inverse" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/opensans_bold"
                android:text="Current name"
                android:textColor="@color/calendar_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvNameDialogCurrentValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/opensans_regular"
                android:text="Apartment 1"
                android:textColor="@color/calendar_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/opensans_bold"
        android:text="New name"
        android:textColor="@color/calendar_text_primary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etNameDialogInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_tenant_calendar_input"
        android:fontFamily="@font/opensans_regular"
        android:hint="Enter updated name"
        android:imeOptions="actionDone"
        android:inputType="textCapWords"
        android:maxLines="1"
        android:minHeight="52dp"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:textColor="@color/calendar_text_primary"
        android:textColorHint="@color/calendar_text_secondary"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNameDialogSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_tenant_calendar_action_primary"
        android:fontFamily="@font/opensans_bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="46dp"
        android:paddingVertical="10dp"
        android:text="Save changes"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        app:backgroundTint="@null"
        app:cornerRadius="16dp"
        app:elevation="0dp"
        app:strokeWidth="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNameDialogCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_tenant_calendar_action_secondary"
        android:fontFamily="@font/opensans_bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="46dp"
        android:paddingVertical="10dp"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textColor="@color/calendar_primary_dark"
        android:textSize="14sp"
        app:backgroundTint="@null"
        app:cornerRadius="16dp"
        app:elevation="0dp"
        app:strokeWidth="0dp" />

</LinearLayout>
