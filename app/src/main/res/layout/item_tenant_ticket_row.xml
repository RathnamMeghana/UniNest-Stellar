<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_card_border_raised"
    android:layout_marginBottom="12dp"
    android:elevation="2dp">

    <!-- Title: "Kitchen: Oven" -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kitchen: Oven"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvRaisedBy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Raised by: Me"
        android:textSize="13sp"
        android:textColor="#757575"
        android:layout_marginBottom="6dp"/>

    <!-- Row 1: Raised on -->
    <TextView
        android:id="@+id/tvRaisedDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Raised on: 12/03/2026"
        android:textSize="13sp"
        android:textColor="#555555"
        android:layout_marginBottom="2dp"/>

    <!-- Row 2: Arrival / Status Message -->
    <TextView
        android:id="@+id/tvStatusMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Waiting for Letting Agent"
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="#777777"
        android:layout_marginBottom="2dp"/>

    <!-- Row 3: Solved Date (Hidden by default) -->
    <TextView
        android:id="@+id/tvSolvedDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Solved: -"
        android:textSize="13sp"
        android:textColor="#333333"
        android:visibility="gone"/>

</LinearLayout>