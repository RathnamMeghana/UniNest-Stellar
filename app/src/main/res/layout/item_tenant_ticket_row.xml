<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_border_raised"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kitchen: Oven"
        android:textColor="@color/app_text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRaisedBy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Raised by you"
        android:textColor="@color/app_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvRaisedDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Raised: 14 Mar 2026, 2:30 PM"
        android:textColor="@color/app_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvDescriptionPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Optional description preview goes here so the issue can be scanned quickly."
        android:textColor="@color/app_text_primary"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvStatusMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Waiting for letting agent review"
        android:textColor="@color/app_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSolvedDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Solved: 15 Mar 2026, 10:15 AM"
        android:textColor="@color/app_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
