<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_tenant_calendar_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/opensans_bold"
            android:letterSpacing="0.06"
            android:text="Room type"
            android:textAllCaps="true"
            android:textColor="@color/calendar_primary_dark"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvRoomTypeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/opensans_bold"
            android:text="Bedrooms"
            android:textColor="@color/calendar_text_primary"
            android:textSize="17sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRoomCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tenant_calendar_today_chip"
        android:fontFamily="@font/opensans_bold"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="12dp"
        android:paddingBottom="7dp"
        android:text="4"
        android:textColor="@color/calendar_today_chip_text"
        android:textSize="12sp" />

</LinearLayout>
