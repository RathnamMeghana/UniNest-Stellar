<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_border_raised"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvBuilding"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Building Name"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="16sp" />


        <TextView
            android:id="@+id/tvPriorityChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_priority_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="High"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#C0392B" />

        <!-- The AI Indicator Star -->
        <ImageView
            android:id="@+id/ivAiStar"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_gemini_sparkle"
            android:visibility="gone"
            app:tint="#7B1FA2" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSubTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apartment 29 - Kitchen"
        android:textColor="#555555"
        android:textSize="14sp"
        android:layout_marginBottom="2dp"/>

    <TextView
        android:id="@+id/tvRaisedBy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Raised by: Sarah"
        android:textColor="#757575"
        android:textSize="13sp"
        android:layout_marginBottom="6dp" />

    <!-- Extra Field: Reported on -->
    <TextView
        android:id="@+id/tvReportedOn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reported on: 12/03/2026"
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_marginBottom="2dp" />

    <!-- Main dynamic status line -->
    <TextView
        android:id="@+id/tvStatusDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Raised on: 12/03/2026"
        android:textStyle="bold"
        android:textColor="#D10000"
        android:textSize="13sp" />

</LinearLayout>