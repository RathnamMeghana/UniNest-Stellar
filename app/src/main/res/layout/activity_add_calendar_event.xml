<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Common Fields -->
        <EditText
            android:id="@+id/etTitle"
            android:hint="Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/etDescription"
            android:hint="Description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Spinner
            android:id="@+id/typeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/etAssignedTo"
            android:hint="Assigned User ID (optional if CHORE)"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- CHORE-specific Fields -->
        <EditText
            android:id="@+id/etRoom"
            android:hint="Room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <EditText
            android:id="@+id/etDuration"
            android:hint="Estimated Duration (minutes)"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <EditText
            android:id="@+id/etDifficulty"
            android:hint="Difficulty Score"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <EditText
            android:id="@+id/etFrequency"
            android:hint="Frequency per week"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveCalendar"
            android:text="Save Event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>


        <!-- CHORE fields container -->
        <LinearLayout
            android:id="@+id/choreFieldsLayout"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:paddingTop="16dp">

            <EditText
                android:id="@+id/etRoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Room (optional)" />

            <EditText
                android:id="@+id/etDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Estimated Duration (min)"
                android:inputType="number" />

            <EditText
                android:id="@+id/etDifficulty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Difficulty Score"
                android:inputType="number" />

            <EditText
                android:id="@+id/etFrequency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Frequency per Week"
                android:inputType="number" />

        </LinearLayout>


    </LinearLayout>


</ScrollView>
