<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tenant_calendar_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/popTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/opensans_bold"
        android:text="Task Title"
        android:textAlignment="viewStart"
        android:textColor="@color/calendar_text_primary"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/popStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_task_status_badge"
        android:fontFamily="@font/opensans_bold"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="Status"
        android:textColor="@color/calendar_text_primary"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="20dp"
        android:background="@color/calendar_primary_soft" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/opensans_bold"
        android:text="DESCRIPTION"
        android:textColor="@color/calendar_text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/popDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/opensans_regular"
        android:lineSpacingExtra="3dp"
        android:text="Description goes here..."
        android:textColor="@color/calendar_text_primary"
        android:textSize="15sp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:columnCount="2"
        android:rowCount="3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/opensans_bold"
                android:text="LOCATION"
                android:textColor="@color/calendar_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/popLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/opensans_bold"
                android:text="Kitchen"
                android:textColor="@color/calendar_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/opensans_bold"
                android:text="ASSIGNED TO"
                android:textColor="@color/calendar_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/popAssignee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/opensans_bold"
                android:text="Name"
                android:textColor="@color/calendar_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/opensans_bold"
                android:text="EST. TIME"
                android:textColor="@color/calendar_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/popEstTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/opensans_bold"
                android:text="-- Mins"
                android:textColor="@color/calendar_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutActualTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/opensans_bold"
                android:text="ACTUAL TIME"
                android:textColor="@color/calendar_status_completed_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/popActualTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/opensans_bold"
                android:text="-- Mins"
                android:textColor="@color/calendar_status_completed_text"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/opensans_bold"
                android:text="DUE ON"
                android:textColor="@color/calendar_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/popDueDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/opensans_bold"
                android:text="-- --"
                android:textColor="@color/calendar_text_primary"
                android:textSize="15sp" />
        </LinearLayout>
    </GridLayout>

    <Button
        android:id="@+id/btnPopClose"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/calendar_primary"
        android:fontFamily="@font/opensans_bold"
        android:text="Close"
        android:textAllCaps="false"
        android:textColor="@color/calendar_text_inverse"
        android:textSize="14sp" />
</LinearLayout>
