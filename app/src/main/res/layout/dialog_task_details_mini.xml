<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/popTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Task Title"
        android:textAlignment="center"
        android:textColor="#212121"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/popStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="Status"
        android:textSize="12sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="20dp"
        android:background="#EEEEEE" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DESCRIPTION"
        android:textColor="#9E9E9E"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/popDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Description goes here..."
        android:textColor="#424242"
        android:textSize="14sp" />

    <!-- Details Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:columnCount="2"
        android:rowCount="3">

        <!-- Location -->
        <LinearLayout android:orientation="vertical" android:layout_columnWeight="1" android:layout_marginBottom="16dp">
            <TextView android:text="LOCATION" android:textSize="10sp" android:textColor="#9E9E9E" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/popLocation" android:text="Kitchen" android:textStyle="bold" android:textColor="#333" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Assigned To -->
        <LinearLayout android:orientation="vertical" android:layout_columnWeight="1" android:layout_marginBottom="16dp">
            <TextView android:text="ASSIGNED TO" android:textSize="10sp" android:textColor="#9E9E9E" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/popAssignee" android:text="Name" android:textStyle="bold" android:textColor="#333" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Est Time -->
        <LinearLayout android:orientation="vertical" android:layout_columnWeight="1" android:layout_marginBottom="16dp">
            <TextView android:text="EST. TIME" android:textSize="10sp" android:textColor="#9E9E9E" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/popEstTime" android:text="-- Mins" android:textStyle="bold" android:textColor="#333" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Actual Time -->
        <LinearLayout android:id="@+id/layoutActualTime" android:orientation="vertical" android:layout_columnWeight="1" android:layout_marginBottom="16dp">
            <TextView android:text="ACTUAL TIME" android:textSize="10sp" android:textColor="#2E7D32" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/popActualTime" android:text="-- Mins" android:textStyle="bold" android:textColor="#2E7D32" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Due On Date (New Field) -->
        <LinearLayout android:orientation="vertical" android:layout_columnWeight="1">
            <TextView android:text="DUE ON" android:textSize="10sp" android:textColor="#9E9E9E" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/popDueDate" android:text="-- --" android:textStyle="bold" android:textColor="#333" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

    </GridLayout>

    <Button
        android:id="@+id/btnPopClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#B792D9"
        android:text="Close"
        android:textAllCaps="false"
        android:textColor="#FFFFFF" />
</LinearLayout>