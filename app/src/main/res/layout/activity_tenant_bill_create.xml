<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tenant_calendar_screen">

    <LinearLayout
        android:id="@+id/fixedHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tenant_calendar_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_tenant_calendar_metric_soft"
                android:clickable="true"
                android:contentDescription="Go back"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_back_arrow"
                    app:tint="@color/calendar_primary_dark" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/opensans_bold"
                    android:letterSpacing="0.08"
                    android:text="Finance"
                    android:textAllCaps="true"
                    android:textColor="@color/calendar_primary_dark"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/opensans_bold"
                    android:text="Create Bill"
                    android:textColor="@color/calendar_text_primary"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fixedHeaderContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tenant_calendar_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/opensans_bold"
                    android:letterSpacing="0.08"
                    android:text="Bill Setup"
                    android:textAllCaps="true"
                    android:textColor="@color/calendar_primary_dark"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/opensans_regular"
                    android:lineSpacingExtra="2dp"
                    android:text="Add the charge details first, then choose which roommates should split it with you."
                    android:textColor="@color/calendar_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/opensans_bold"
                    android:letterSpacing="0.05"
                    android:text="Bill Title"
                    android:textAllCaps="true"
                    android:textColor="@color/calendar_text_secondary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etBillTitle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tenant_calendar_input"
                    android:fontFamily="@font/opensans_regular"
                    android:hint="e.g. Monthly rent"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/calendar_text_primary"
                    android:textColorHint="@color/calendar_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/opensans_bold"
                    android:letterSpacing="0.05"
                    android:text="Total Amount"
                    android:textAllCaps="true"
                    android:textColor="@color/calendar_text_secondary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etAmount"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tenant_calendar_input"
                    android:fontFamily="@font/opensans_regular"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/calendar_text_primary"
                    android:textColorHint="@color/calendar_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/opensans_bold"
                    android:letterSpacing="0.05"
                    android:text="Bill Type"
                    android:textAllCaps="true"
                    android:textColor="@color/calendar_text_secondary"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spinnerBillType"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tenant_calendar_spinner"
                    android:gravity="center_vertical"
                    android:paddingEnd="40dp"
                    android:popupBackground="@drawable/bg_tenant_calendar_dialog"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:id="@+id/tvFrequencyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/opensans_bold"
                    android:letterSpacing="0.05"
                    android:text="Repeat Every"
                    android:textAllCaps="true"
                    android:textColor="@color/calendar_text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <Spinner
                    android:id="@+id/spinnerFrequency"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tenant_calendar_spinner"
                    android:gravity="center_vertical"
                    android:paddingEnd="40dp"
                    android:popupBackground="@drawable/bg_tenant_calendar_dialog"
                    android:spinnerMode="dropdown"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/opensans_bold"
                    android:letterSpacing="0.05"
                    android:text="Due Date"
                    android:textAllCaps="true"
                    android:textColor="@color/calendar_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnPickDate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tenant_calendar_spinner"
                    android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                    android:fontFamily="@font/opensans_bold"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="40dp"
                    android:text="Select due date"
                    android:textColor="@color/calendar_text_secondary"
                    android:textSize="14sp"
                    app:drawableTint="@color/calendar_primary_dark" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_tenant_calendar_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/opensans_bold"
                    android:letterSpacing="0.08"
                    android:text="Split With"
                    android:textAllCaps="true"
                    android:textColor="@color/calendar_primary_dark"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/opensans_regular"
                    android:lineSpacingExtra="2dp"
                    android:text="Choose everyone who should be included in this shared charge."
                    android:textColor="@color/calendar_text_secondary"
                    android:textSize="13sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRoommates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_tenant_calendar_metric_primary"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/opensans_bold"
                    android:letterSpacing="0.08"
                    android:text="Split Preview"
                    android:textAllCaps="true"
                    android:textColor="@color/calendar_text_inverse"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvSplitAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/opensans_bold"
                    android:text="Each selected roommate pays: &#8364;0.00"
                    android:textColor="@color/calendar_text_inverse"
                    android:textSize="21sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/opensans_regular"
                    android:text="This updates as you change the amount or who is included."
                    android:textColor="@color/calendar_text_inverse"
                    android:textSize="12sp"
                    android:alpha="0.92" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitBill"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_tenant_calendar_action_primary"
                android:fontFamily="@font/opensans_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="58dp"
                android:text="Create &amp; Split Bill"
                android:textAllCaps="false"
                android:textColor="@color/calendar_text_inverse"
                android:textSize="16sp"
                app:backgroundTint="@null"
                app:cornerRadius="16dp"
                app:elevation="0dp"
                app:strokeWidth="0dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
