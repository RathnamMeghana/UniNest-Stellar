<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_surface">

    <View
        android:id="@+id/headerBgBlob"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@drawable/bg_header_pink_circle"
        android:translationX="-50dp"
        android:translationY="-50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvScreenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="Create New Bill"
        android:textColor="@color/app_text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvScreenTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/app_surface_alt"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/LabelStyle"
                        android:letterSpacing="0.05"
                        android:text="Bill Title"
                        android:textAllCaps="true" />

                    <EditText
                        android:id="@+id/etBillTitle"
                        style="@style/InputStyle"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="e.g. Monthly rent"
                        android:padding="12dp" />

                    <TextView
                        style="@style/LabelStyle"
                        android:layout_marginTop="16dp"
                        android:letterSpacing="0.05"
                        android:text="Total Amount (&#8364;)"
                        android:textAllCaps="true" />

                    <EditText
                        android:id="@+id/etAmount"
                        style="@style/InputStyle"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:padding="12dp" />

                    <TextView
                        style="@style/LabelStyle"
                        android:layout_marginTop="16dp"
                        android:letterSpacing="0.05"
                        android:text="Payment Type"
                        android:textAllCaps="true" />

                    <Spinner
                        android:id="@+id/spinnerBillType"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_spinner_field"
                        android:spinnerMode="dropdown" />

                    <TextView
                        android:id="@+id/tvFrequencyLabel"
                        style="@style/LabelStyle"
                        android:layout_marginTop="16dp"
                        android:text="Repeat Every"
                        android:visibility="gone" />

                    <Spinner
                        android:id="@+id/spinnerFrequency"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_spinner_field"
                        android:spinnerMode="dropdown"
                        android:visibility="gone" />

                    <TextView
                        style="@style/LabelStyle"
                        android:layout_marginTop="16dp"
                        android:letterSpacing="0.05"
                        android:text="Due Date"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/btnPickDate"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_spinner_field"
                        android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:text="Select Date"
                        android:textColor="@color/app_text_primary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="20dp"
                android:text="Split with Roommates"
                android:textColor="@color/app_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/app_surface_alt"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRoommates"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="@color/app_surface_alt"
                    android:padding="8dp" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_summary_chip"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/tvSplitAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Each person: &#8364;0.00"
                    android:textColor="@color/app_accent_purple"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitBill"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:backgroundTint="@color/app_accent_purple"
                android:text="Create Bill"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="30dp"
                app:elevation="4dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
