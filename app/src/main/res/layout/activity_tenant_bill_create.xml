<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 1. Header Blob  -->
    <View
        android:id="@+id/headerBgBlob"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@drawable/bg_header_pink_circle"
        android:translationX="-50dp"
        android:translationY="-50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Screen Title  -->

    <!-- 3. Scrollable Content -->
    <TextView
        android:id="@+id/tvScreenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="Create New Bill"
        android:textColor="#000000"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.46"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvScreenTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Input Section Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Title -->
                    <TextView
                        style="@style/LabelStyle"
                        android:text="Bill Title"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"/>

                    <EditText
                        android:id="@+id/etBillTitle"
                        style="@style/InputStyle"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="e.g. Monthly Rent"
                        android:padding="12dp" />

                    <!-- Amount -->
                    <TextView
                        style="@style/LabelStyle"
                        android:layout_marginTop="16dp"
                        android:text="Total Amount (€)"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"/>

                    <EditText
                        android:id="@+id/etAmount"
                        style="@style/InputStyle"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:padding="12dp" />

                    <!-- Bill Type -->
                    <TextView
                        style="@style/LabelStyle"
                        android:layout_marginTop="16dp"
                        android:text="Payment Type"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"/>

                    <Spinner
                        android:id="@+id/spinnerBillType"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_spinner_field"
                        android:spinnerMode="dropdown" />

                    <!-- Frequency (Hidden by default) -->
                    <TextView
                        android:id="@+id/tvFrequencyLabel"
                        style="@style/LabelStyle"
                        android:layout_marginTop="16dp"
                        android:text="Repeat Every"
                        android:textColor="#888888"
                        android:visibility="gone" />

                    <Spinner
                        android:id="@+id/spinnerFrequency"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_spinner_field"
                        android:spinnerMode="dropdown"
                        android:visibility="gone" />

                    <!-- Due Date -->
                    <TextView
                        style="@style/LabelStyle"
                        android:layout_marginTop="16dp"
                        android:text="Due Date"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"/>

                    <TextView
                        android:id="@+id/btnPickDate"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_spinner_field"
                        android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:text="Select Date"
                        android:textColor="#333" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Roommate Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="20dp"
                android:text="Split with Roommates"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRoommates"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="#FFFFFF"
                    android:padding="8dp" />
            </androidx.cardview.widget.CardView>

            <!-- Split Preview Chip -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_status_progress"
                android:backgroundTint="#F0E6F7"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/tvSplitAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Each person: €0.00"
                    android:textColor="#B792D9"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Submit Button (Pill Styled) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitBill"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:backgroundTint="#00BCD4"
                android:text="Create Bill"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="30dp"
                app:elevation="4dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>