<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tenant_calendar_screen">

    <LinearLayout
        android:id="@+id/fixedHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tenant_calendar_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/opensans_bold"
                android:letterSpacing="0.08"
                android:text="Portfolio"
                android:textAllCaps="true"
                android:textColor="@color/calendar_primary_dark"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/opensans_bold"
                android:text="Add Multiple Apartments"
                android:textColor="@color/calendar_text_primary"
                android:textSize="22sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/opensans_regular"
                android:text="Create several apartments at once using one shared room template and occupancy setup."
                android:textColor="@color/calendar_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnCreateAll"
        app:layout_constraintTop_toBottomOf="@id/fixedHeaderContainer">

        <LinearLayout
            android:id="@+id/linearFormContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tenant_calendar_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/opensans_bold"
                    android:letterSpacing="0.05"
                    android:text="Maximum Tenants Per Apartment"
                    android:textAllCaps="true"
                    android:textColor="@color/calendar_text_secondary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etMaxTenants"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tenant_calendar_input"
                    android:gravity="center_vertical"
                    android:hint="e.g. 4"
                    android:inputType="number"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/calendar_text_primary"
                    android:textColorHint="@color/calendar_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/opensans_bold"
                    android:letterSpacing="0.05"
                    android:text="Number of Apartments"
                    android:textAllCaps="true"
                    android:textColor="@color/calendar_text_secondary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etApartmentCount"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tenant_calendar_input"
                    android:gravity="center_vertical"
                    android:hint="e.g. 10"
                    android:inputType="number"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/calendar_text_primary"
                    android:textColorHint="@color/calendar_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tenant_calendar_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/opensans_bold"
                    android:letterSpacing="0.05"
                    android:text="Room Layout Per Apartment"
                    android:textAllCaps="true"
                    android:textColor="@color/calendar_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/opensans_regular"
                    android:text="Set how many of each room type every new apartment should start with."
                    android:textColor="@color/calendar_text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/layoutRoomCounters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <include layout="@layout/view_room_counter_row" />
                    <include layout="@layout/view_room_counter_row" />
                    <include layout="@layout/view_room_counter_row" />
                    <include layout="@layout/view_room_counter_row" />
                    <include layout="@layout/view_room_counter_row" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreateAll"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="@color/calendar_primary_dark"
        android:text="Create Apartments"
        android:textAllCaps="false"
        android:textColor="@color/calendar_text_inverse"
        android:textStyle="bold"
        app:cornerRadius="18dp"
        app:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
