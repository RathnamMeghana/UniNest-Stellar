<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:id="@+id/popTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kitchen: Oven"
        android:textAlignment="center"
        android:textColor="#212121"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Badge Styled Status -->
    <TextView
        android:id="@+id/popStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:text="IN PROGRESS"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/bg_status_progress" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="20dp"
        android:background="#EEEEEE" />

    <!-- Description -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DESCRIPTION"
        android:textColor="#9E9E9E"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <TextView
        android:id="@+id/popDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="The oven stopped working this morning..."
        android:textColor="#424242"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp" />

    <ImageView
        android:id="@+id/popTicketImage"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:visibility="gone"
        android:background="#EEEEEE" />

    <!-- Details Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:columnCount="2">

        <LinearLayout android:orientation="vertical" android:layout_columnWeight="1" android:layout_marginBottom="16dp">
            <TextView android:text="ROOM" android:textSize="10sp" android:textColor="#9E9E9E" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/popLocation" android:text="Kitchen" android:textStyle="bold" android:textColor="#333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp"/>
        </LinearLayout>

        <LinearLayout android:orientation="vertical" android:layout_columnWeight="1" android:layout_marginBottom="16dp">
            <TextView android:text="RAISED BY" android:textSize="10sp" android:textColor="#9E9E9E" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/popRaisedBy" android:text="Me" android:textStyle="bold" android:textColor="#333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp"/>
        </LinearLayout>

        <LinearLayout android:orientation="vertical" android:layout_columnWeight="1">
            <TextView android:text="AGENT ARRIVAL" android:textSize="10sp" android:textColor="#9E9E9E" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/popArrival" android:text="Not scheduled" android:textStyle="bold" android:textColor="#00BCD4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp"/>
        </LinearLayout>
    </GridLayout>


    <LinearLayout
        android:id="@+id/layoutAgentResponse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:background="#F8F4FF"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Left Accent Bar -->
        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="#B792D9"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:text="AGENT NOTE"
                android:textSize="10sp"
                android:textColor="#5B2C83"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"/>

            <TextView
                android:id="@+id/popAgentMessage"
                android:text="Agent response text..."
                android:textColor="#4A4A4A"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="1dp"/>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPopClose"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#B792D9"
        android:text="Close"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:cornerRadius="27dp"
        app:elevation="0dp"/>
</LinearLayout>