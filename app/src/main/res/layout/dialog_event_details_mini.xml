<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:id="@+id/popTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Event Title"
        android:textAlignment="center"
        android:textColor="#212121"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Type Badge -->
    <TextView
        android:id="@+id/popTypeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_status_pending"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="EVENT"
        android:textColor="#C62828"
        android:textSize="12sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="20dp"
        android:background="#EEEEEE" />

    <!-- Details Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2">

        <!-- Date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATE"
                android:textColor="#9E9E9E"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/popDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tomorrow"
                android:textColor="#333333"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Time (Events only) -->
        <LinearLayout
            android:id="@+id/layoutTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIME"
                android:textColor="#9E9E9E"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/popTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:00"
                android:textColor="#333333"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Amount (Bills only) -->
        <LinearLayout
            android:id="@+id/layoutAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AMOUNT"
                android:textColor="#E65100"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/popAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="€0.00"
                android:textColor="#E65100"
                android:textStyle="bold" />
        </LinearLayout>
    </GridLayout>

    <!-- Description Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="DESCRIPTION"
        android:textColor="#9E9E9E"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/popDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="No description provided."
        android:textColor="#424242"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnPopClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#B792D9"
        android:text="Close"
        android:textAllCaps="false"
        android:textColor="#FFFFFF" />
</LinearLayout>
