<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 1. Header Blob  -->
    <View
        android:id="@+id/headerBgBlob"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@drawable/bg_header_pink_circle"
        android:translationX="-50dp"
        android:translationY="-50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Apartment Bills"
        android:textColor="#000000"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="45dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Tab Switcher -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/billTabLayout"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_tab_track"
        app:tabBackground="@drawable/selector_bill_tab"
        app:layout_constraintTop_toBottomOf="@id/headerTitle"
        app:tabIndicatorHeight="0dp"
        app:tabRippleColor="@null"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabSelectedTextColor="#00BCD4"
        app:tabTextColor="#8E8E93"
        app:tabTextAppearance="@style/TextAppearance.AppCompat.Body2">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bills to Pay" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Owed to Me" />
    </com.google.android.material.tabs.TabLayout>

    <!-- 3. Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/billTabLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddBill"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="+ Add New Bill"
                android:textColor="#E91E63"
                android:backgroundTint="#FFFFFF"
                android:textAllCaps="false"
                app:strokeColor="#E91E63"
                app:strokeWidth="1dp"
                app:cornerRadius="20dp"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp"
                app:elevation="2dp"/>

            <TextView
                android:id="@+id/tvTotalSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Total You Owe: €0.00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/tvActiveHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Bills to Pay"
                android:textStyle="bold"
                android:textColor="#6C2BA4"
                android:textSize="22sp"
                android:layout_marginBottom="12dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBillsActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/tvHistoryHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Paid History"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:textSize="22sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBillsHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="40dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 4. Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#FFFFFF"
        android:elevation="16dp"
        app:menu="@menu/tenant_bottom_nav"
        app:labelVisibilityMode="labeled"
        style="@style/Widget.Design.BottomNavigationView"
        app:itemBackground="@drawable/bg_nav_pill_custom"
        app:itemIconSize="50dp"
        app:itemIconTint="@color/selector_nav_icon"
        app:itemTextColor="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>