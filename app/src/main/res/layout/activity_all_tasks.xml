<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#B299D1"
        android:gravity="center"
        android:text="Tasks"
        android:textColor="@android:color/white"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!-- Roommate Filter Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filter Tasks"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_margin="16dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRoommateFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:clipToPadding="false"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- One-time Section -->
            <TextView
                android:id="@+id/tvHeaderOnce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="One-Time Tasks"
                android:textColor="#6C2BA4"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone"/>
            <LinearLayout
                android:id="@+id/containerOnce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"/>

            <!-- Weekly Section -->
            <TextView
                android:id="@+id/tvHeaderWeekly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Weekly Tasks"
                android:textSize="22sp"
                android:textColor="#6C2BA4"
                android:textStyle="bold"
                android:visibility="gone"/>
            <LinearLayout
                android:id="@+id/containerWeekly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"/>

            <!-- Monthly Section -->
            <TextView
                android:id="@+id/tvHeaderMonthly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Monthly Tasks"
                android:textSize="22sp"
                android:textColor="#6C2BA4"
                android:textStyle="bold"
                android:visibility="gone"/>
            <LinearLayout
                android:id="@+id/containerMonthly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"/>

            <!-- Completed History - GREEN & CENTERED -->
            <TextView
                android:id="@+id/tvHeaderHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Completed History"
                android:textSize="22sp"
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/containerHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="32dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>