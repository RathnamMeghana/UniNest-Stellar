<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tenant_calendar_screen">

    <LinearLayout
        android:id="@+id/fixedHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tenant_calendar_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <FrameLayout
                android:layout_width="102dp"
                android:layout_height="102dp"
                android:background="@drawable/bg_profile_avatar_ring"
                android:padding="4dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfileImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Profile image"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_profile_tenant"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    app:strokeWidth="0dp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/opensans_bold"
                    android:letterSpacing="0.08"
                    android:text="Profile"
                    android:textAllCaps="true"
                    android:textColor="@color/calendar_primary_dark"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/opensans_bold"
                    android:text="John Doe"
                    android:textColor="@color/calendar_text_primary"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvUserEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/opensans_regular"
                    android:text="john.doe@email.com"
                    android:textColor="@color/calendar_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
        app:layout_constraintTop_toBottomOf="@id/fixedHeaderContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp">

            <TextView
                style="@style/SettingsHeaderStyle"
                android:text="Account Settings" />

            <androidx.cardview.widget.CardView style="@style/SettingsCardStyle">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowEditName"
                        layout="@layout/layout_settings_item" />

                    <View style="@style/DividerStyle" />

                    <include
                        android:id="@+id/rowEditPassword"
                        layout="@layout/layout_settings_item" />

                    <View style="@style/DividerStyle" />

                    <include
                        android:id="@+id/rowEditImage"
                        layout="@layout/layout_settings_item" />

                    <View style="@style/DividerStyle" />

                    <include
                        android:id="@+id/rowNotifications"
                        layout="@layout/layout_settings_item" />

                    <View style="@style/DividerStyle" />

                    <include
                        android:id="@+id/rowDarkMode"
                        layout="@layout/layout_settings_switch" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                style="@style/SettingsHeaderStyle"
                android:layout_marginTop="18dp"
                android:text="Safety &amp; Urgency"
                android:textColor="@color/calendar_status_overdue_text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tenant_ticket_section_raised"
                android:orientation="vertical"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/rowEmergency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="74dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tenant_calendar_surface">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@android:drawable/ic_menu_call"
                            app:tint="@color/calendar_status_overdue_text" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/opensans_bold"
                            android:text="Emergency Contact"
                            android:textColor="@color/calendar_text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/opensans_regular"
                            android:text="+353 87 123 4567"
                            android:textColor="@color/calendar_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCallEmergency"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:backgroundTint="@color/calendar_surface"
                        android:fontFamily="@font/opensans_bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="Call"
                        android:textAllCaps="false"
                        android:textColor="@color/calendar_status_overdue_text"
                        android:textSize="12sp"
                        app:cornerRadius="14dp"
                        app:elevation="0dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/SettingsHeaderStyle"
                android:layout_marginTop="18dp"
                android:text="Support &amp; Legal" />

            <androidx.cardview.widget.CardView style="@style/SettingsCardStyle">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowSupport"
                        layout="@layout/layout_settings_item" />

                    <View style="@style/DividerStyle" />

                    <include
                        android:id="@+id/rowAbout"
                        layout="@layout/layout_settings_item" />

                    <View style="@style/DividerStyle" />

                    <include
                        android:id="@+id/rowFaq"
                        layout="@layout/layout_settings_item" />

                    <View style="@style/DividerStyle" />

                    <include
                        android:id="@+id/rowPrivacy"
                        layout="@layout/layout_settings_item" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_profile_logout_action"
                android:fontFamily="@font/opensans_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Logout"
                android:textAllCaps="false"
                android:textColor="@color/calendar_text_inverse"
                android:textSize="15sp"
                app:backgroundTint="@null"
                app:cornerRadius="16dp"
                app:elevation="0dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        style="@style/Widget.Design.BottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/calendar_surface"
        android:elevation="16dp"
        app:itemBackground="@drawable/bg_nav_pill_custom"
        app:itemIconSize="50dp"
        app:itemIconTint="@color/selector_nav_icon"
        app:itemTextColor="@color/selector_nav_text"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/tenant_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
