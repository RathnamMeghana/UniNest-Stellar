<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_building_card"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#D4BAF1">

        <!-- Avatar: for now using placeholder -->
        <ImageView
            android:id="@+id/imgTenantAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_profile"
            android:scaleType="centerCrop"
            android:padding="4dp"
            tools:ignore="ContentDescription" />

        <!-- Name -->
        <TextView
            android:id="@+id/tvTenantName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text=""
            tools:text="Maya Smith"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <!-- Room label -->
        <TextView
            android:id="@+id/tvRoomLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            tools:text="Room 1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#6C2BA4" />

        <Button
            android:id="@+id/btnDeleteTenant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Remove"
            android:textColor="@android:color/white" />


    </LinearLayout>

</FrameLayout>
