<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tenant_calendar_screen">

    <LinearLayout
        android:id="@+id/fixedHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tenant_calendar_surface"
            android:orientation="vertical"
            android:paddingStart="11dp"
            android:paddingTop="10dp"
            android:paddingEnd="11dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:fontFamily="@font/opensans_bold"
                    android:letterSpacing="0.08"
                    android:text="Planner"
                    android:textAllCaps="true"
                    android:textColor="@color/calendar_text_primary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:autoSizeMaxTextSize="26sp"
                    android:autoSizeMinTextSize="18sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/opensans_bold"
                    android:maxLines="1"
                    android:text="Calendar"
                    android:textColor="@color/calendar_text_primary"
                    android:textSize="23sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHeroSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/opensans_regular"
                android:maxLines="1"
                android:text="Chores, events, reminders and bills in one timeline."
                android:textColor="@color/calendar_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/heroActionStack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewTasks"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tenant_calendar_action_secondary"
                    android:fontFamily="@font/opensans_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="44dp"
                    android:text="View tasks"
                    android:textAllCaps="false"
                    android:textColor="@color/calendar_text_primary"
                    android:textSize="12sp"
                    app:backgroundTint="@null"
                    app:cornerRadius="16dp"
                    app:strokeWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddEvent"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tenant_calendar_action_primary"
                    android:fontFamily="@font/opensans_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="44dp"
                    android:text="+ Add entry"
                    android:textAllCaps="false"
                    android:textColor="@color/calendar_text_inverse"
                    android:textSize="12sp"
                    app:backgroundTint="@null"
                    app:cornerRadius="16dp"
                    app:strokeWidth="0dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_tenant_calendar_surface"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/filterAll"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tenant_calendar_filter_all"
                android:focusable="true"
                android:fontFamily="@font/opensans_bold"
                android:gravity="center"
                android:maxLines="1"
                android:minHeight="44dp"
                android:paddingHorizontal="6dp"
                android:text="All"
                android:textColor="@color/calendar_text_inverse"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterChores"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tenant_calendar_filter_neutral"
                android:focusable="true"
                android:fontFamily="@font/opensans_bold"
                android:gravity="center"
                android:maxLines="1"
                android:minHeight="44dp"
                android:paddingHorizontal="6dp"
                android:text="Chores"
                android:textColor="@color/calendar_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterEvents"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tenant_calendar_filter_neutral"
                android:focusable="true"
                android:fontFamily="@font/opensans_bold"
                android:gravity="center"
                android:maxLines="1"
                android:minHeight="44dp"
                android:paddingHorizontal="6dp"
                android:text="Events"
                android:textColor="@color/calendar_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filterReminders"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tenant_calendar_filter_neutral"
                android:focusable="true"
                android:fontFamily="@font/opensans_bold"
                android:gravity="center"
                android:maxLines="1"
                android:minHeight="44dp"
                android:paddingHorizontal="6dp"
                android:text="Reminders"
                android:textColor="@color/calendar_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
        app:layout_constraintTop_toBottomOf="@id/fixedHeaderContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:id="@+id/overviewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:background="@drawable/bg_tenant_calendar_surface"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="9dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvOverviewLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:fontFamily="@font/opensans_bold"
                        android:letterSpacing="0.05"
                        android:text="Day snapshot"
                        android:textAllCaps="true"
                        android:textColor="@color/calendar_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvInsightDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/opensans_bold"
                    android:maxLines="1"
                    android:text="March 14"
                    android:textColor="@color/calendar_text_primary"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tenant_calendar_metric_primary"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="6dp">

                        <TextView
                            android:id="@+id/tvInsightVisibleCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/opensans_bold"
                            android:maxLines="1"
                            android:text="0"
                            android:textColor="@color/calendar_text_inverse"
                            android:textSize="19sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/opensans_regular"
                            android:maxLines="1"
                            android:text="Visible"
                            android:textColor="@color/calendar_text_inverse"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tenant_calendar_metric_soft"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="6dp">

                        <TextView
                            android:id="@+id/tvInsightReminderCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/opensans_bold"
                            android:maxLines="1"
                            android:text="0"
                            android:textColor="@color/calendar_text_primary"
                            android:textSize="19sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/opensans_regular"
                            android:maxLines="1"
                            android:text="Reminders"
                            android:textColor="@color/calendar_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tenant_calendar_metric_alert"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="6dp">

                        <TextView
                            android:id="@+id/tvInsightOverdueCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/opensans_bold"
                            android:maxLines="1"
                            android:text="0"
                            android:textColor="@color/calendar_status_overdue_text"
                            android:textSize="19sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/opensans_regular"
                            android:maxLines="1"
                            android:text="Overdue"
                            android:textColor="@color/calendar_status_overdue_text"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/calendarCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tenant_calendar_surface"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btnToggleCalendar"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_tenant_calendar_toggle"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/tvCalendarLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/opensans_bold"
                            android:text="Viewing"
                            android:textAllCaps="true"
                            android:textColor="@color/calendar_text_inverse"
                            android:textSize="11sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvCurrentDateHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/opensans_bold"
                            android:maxLines="1"
                            android:text="Today"
                            android:textColor="@color/calendar_text_inverse"
                            android:textSize="15sp"
                            app:layout_constraintEnd_toStartOf="@id/imgToggleArrow"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvCalendarLabel" />

                        <ImageView
                            android:id="@+id/imgToggleArrow"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_calendar_chevron_down"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/calendar_text_inverse" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <com.applandeo.materialcalendarview.CalendarView
                        android:id="@+id/calendarView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_tenant_calendar_month_panel"
                        android:clipToOutline="true"
                        android:visibility="gone"
                        app:abbreviationsBarColor="@color/calendar_primary_softer"
                        app:abbreviationsLabelsColor="@color/calendar_text_primary"
                        app:daysLabelsColor="@color/calendar_text_primary"
                        app:eventsEnabled="true"
                        app:forwardButtonSrc="@drawable/ic_calendar_chevron_right"
                        app:headerColor="@color/calendar_surface"
                        app:headerLabelColor="@color/calendar_text_primary"
                        app:pagesColor="@color/calendar_surface_alt"
                        app:previousButtonSrc="@drawable/ic_calendar_chevron_left"
                        app:selectionColor="@color/calendar_primary"
                        app:selectionLabelColor="@color/calendar_text_inverse"
                        app:todayLabelColor="@color/calendar_text_primary"
                        app:type="one_day_picker" />

                    <LinearLayout
                        android:id="@+id/weekViewContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_tenant_calendar_week_strip"
                        android:baselineAligned="false"
                        android:minHeight="72dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="4dp"
                        android:visibility="visible" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/emptyStateCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tenant_calendar_empty_state"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/opensans_bold"
                    android:text="Nothing scheduled"
                    android:textColor="@color/calendar_text_primary"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tvEmptyBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/opensans_regular"
                    android:text="Try another day or switch filters to see more activity."
                    android:textColor="@color/calendar_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp">

                <LinearLayout
                    android:id="@+id/sectionChores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_tenant_calendar_section_chore"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="8dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_dot_green" />

                        <TextView
                            android:id="@+id/tvHeaderChores"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/opensans_bold"
                            android:text="Chores"
                            android:textColor="@color/calendar_chore_text"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerChores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_tenant_calendar_section_event"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="8dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_dot_event" />

                        <TextView
                            android:id="@+id/tvHeaderEvents"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/opensans_bold"
                            android:text="Events"
                            android:textColor="@color/calendar_event_text"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerEvents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionReminders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_tenant_calendar_section_reminder"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="8dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_dot_reminder" />

                        <TextView
                            android:id="@+id/tvHeaderReminders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/opensans_bold"
                            android:text="Reminders &amp; Bills"
                            android:textColor="@color/calendar_reminder_text"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerReminders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        style="@style/Widget.Design.BottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/calendar_surface"
        android:elevation="16dp"
        app:itemBackground="@drawable/bg_nav_pill_custom"
        app:itemIconSize="50dp"
        app:itemIconTint="@color/selector_nav_icon"
        app:itemRippleColor="@null"
        app:itemTextColor="@color/selector_nav_text"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/tenant_bottom_nav" />
</androidx.constraintlayout.widget.ConstraintLayout>
