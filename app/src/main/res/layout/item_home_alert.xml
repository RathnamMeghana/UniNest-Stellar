<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAlert"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/app_surface_alt"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:rippleColor="@color/calendar_primary_soft"
    app:strokeColor="@color/app_outline"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="94dp"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <FrameLayout
            android:id="@+id/layoutIconBadge"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_soft_badge"
            android:importantForAccessibility="no"
            android:padding="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5">

            <ImageView
                android:id="@+id/imgAlertIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="centerInside"
                android:src="@drawable/ic_notifications" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvAlertType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_soft_badge"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="Calendar"
            android:textColor="@color/app_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/layoutIconBadge"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvAlertMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Today at 2:30 PM"
            android:textAlignment="viewEnd"
            android:textColor="@color/app_text_secondary"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/tvAlertType"
            app:layout_constraintEnd_toStartOf="@id/btnDeleteAlert"
            app:layout_constraintStart_toEndOf="@id/tvAlertType"
            app:layout_constraintTop_toTopOf="@id/tvAlertType" />

        <ImageButton
            android:id="@+id/btnDeleteAlert"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_soft_badge"
            android:contentDescription="Delete alert"
            android:padding="10dp"
            android:src="@drawable/ic_alert_dismiss"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvAlertTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Alert Title"
            android:textColor="@color/app_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnDeleteAlert"
            app:layout_constraintStart_toStartOf="@id/tvAlertType"
            app:layout_constraintTop_toBottomOf="@id/tvAlertType" />

        <TextView
            android:id="@+id/tvAlertSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="What changed will appear here so the alert makes sense at first glance."
            android:textColor="@color/app_text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/btnDeleteAlert"
            app:layout_constraintStart_toStartOf="@id/tvAlertTitle"
            app:layout_constraintTop_toBottomOf="@id/tvAlertTitle"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
