<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_summary_chip"
    android:backgroundTint="#FFFFFF"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header Area -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvClearAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear All"
            android:textColor="#B792D9"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_centerVertical="true"
            android:padding="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Filter Options"
            android:textColor="#2C3E50"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:contentDescription="Close filters"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#000" />
    </RelativeLayout>

    <!-- Sort By Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Sort By:"
        android:textColor="#888888"
        android:textSize="12sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgSort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <RadioButton android:id="@+id/rbBuilding" android:layout_width="match_parent" android:layout_height="48dp" android:text="Building" android:buttonTint="#B792D9" android:background="@drawable/bg_filter_item" android:layout_marginBottom="8dp" android:paddingStart="12dp"/>
        <RadioButton android:id="@+id/rbPriority" android:layout_width="match_parent" android:layout_height="48dp" android:text="Priority" android:buttonTint="#B792D9" android:background="@drawable/bg_filter_item" android:layout_marginBottom="8dp" android:paddingStart="12dp"/>
        <RadioButton android:id="@+id/rbDate" android:layout_width="match_parent" android:layout_height="48dp" android:text="Date" android:buttonTint="#B792D9" android:background="@drawable/bg_filter_item" android:paddingStart="12dp"/>
    </RadioGroup>

    <!-- Priority Filters -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Filter by Priority:"
        android:textColor="#888888"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/chipHigh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="High" android:gravity="center" android:paddingVertical="10dp" android:background="@drawable/bg_chip_unselected" android:textColor="#C62828" android:layout_marginEnd="8dp"/>
        <TextView android:id="@+id/chipMedium" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Medium" android:gravity="center" android:paddingVertical="10dp" android:background="@drawable/bg_chip_unselected" android:textColor="#EF6C00" android:layout_marginEnd="8dp"/>
        <TextView android:id="@+id/chipLow" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Low" android:gravity="center" android:paddingVertical="10dp" android:background="@drawable/bg_chip_unselected" android:textColor="#2E7D32"/>
    </LinearLayout>

    <!-- State Filters -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Filter by State:"
        android:textColor="#888888"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/stateRaised" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Raised" android:gravity="center" android:paddingVertical="10dp" android:background="@drawable/bg_chip_unselected" android:textColor="#C62828" android:layout_marginEnd="8dp"/>
        <TextView android:id="@+id/stateProgress" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="In Progress" android:gravity="center" android:paddingVertical="10dp" android:background="@drawable/bg_chip_unselected" android:textColor="#EF6C00" android:layout_marginEnd="8dp"/>
        <TextView android:id="@+id/stateSolved" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Solved" android:gravity="center" android:paddingVertical="10dp" android:background="@drawable/bg_chip_unselected" android:textColor="#2E7D32"/>
    </LinearLayout>

    <!-- Deleted Tickets Toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@drawable/bg_filter_item">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show Deleted"
                android:textColor="#2C3E50"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Include tickets removed by tenants"
                android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swDeleted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="#B792D9"
            app:trackTint="#D1C4E9" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitFilter"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#B792D9"
        android:text="Apply Filters"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="16sp"
        app:cornerRadius="30dp" />
</LinearLayout>
