<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Soft luminous glow -->
    <item>
        <shape>
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="20dp"/>
            <!-- thinner + lighter -->
            <stroke
                android:width="4dp"
                android:color="@color/glow_low_soft"/>
        </shape>
    </item>

    <!-- Main card -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape>
            <solid android:color="@android:color/white"/>
            <corners android:radius="16dp"/>
            <!-- thinner border -->
            <stroke
                android:width="1.2dp"
                android:color="@color/border_low"/>
        </shape>
    </item>

</layer-list>
